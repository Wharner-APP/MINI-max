#include <winver.h>
@MM_RC_ICON@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MM_VERSION_RC@
 PRODUCTVERSION @MM_VERSION_RC@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "@MM_COMPANY@"
            VALUE "FileDescription", "@MM_RC_DESC@"
            VALUE "FileVersion", "@MM_VERSION_STR@"
            VALUE "InternalName", "@MM_RC_FILE@"
            VALUE "LegalCopyright", "Copyright (C) @MM_COPYRIGHT@"
            VALUE "OriginalFilename", "@MM_RC_FILE@"
            VALUE "ProductName", "@MM_APP_NAME@"
            VALUE "ProductVersion", "@MM_VERSION_STR@"
            VALUE "Comments", "Developer: @MM_COMPANY@"
            VALUE "WebSite", "@MM_WEBSITE@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END
